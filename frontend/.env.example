# Copy this file to ".env" and fill in the values.

# Backend base URL (without /api). Defaults to the Render deployment if empty.
VITE_API_BASE_URL=https://vayam-music-1.onrender.com

# Machine Learning & YouTube audio streaming API base URL
VITE_ML_API_URL=https://vayam-music-ml-api.onrender.com

# Google OAuth Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Add your frontend URL (http://localhost:5173 and the deployed URL) to
# "Authorized JavaScript origins". Leave empty to disable Google sign-in.
VITE_GOOGLE_CLIENT_ID=
